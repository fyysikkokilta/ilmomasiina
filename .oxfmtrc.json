{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "ignorePatterns": ["**/.git", "node_modules", "**/dist", "**/build", "**/coverage", ".env", "pnpm-lock.yaml"],
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"]
      },
      {
        "groupName": "tietokilta",
        "elementNamePattern": ["@tietokilta/**"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external"],
      "tietokilta",
      {
        "newlinesBetween": false
      },
      ["internal", "subpath", "parent", "sibling", "index"],
      ["side_effect_style", "side_effect", "style"],
      "unknown"
    ]
  }
}
