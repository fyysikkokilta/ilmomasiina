       var valueToSet = formInitialValue !== undefined ? formInitialValue : initialValue;
-      if (valueToSet !== undefined) {
+      // PATCHED: only restore the initial value when the form holds no value for this field.
+      // Fields that are re-registered under a new name, like array items after a move or
+      // removal, would otherwise be reset to their initial values.
+      var currentValue = formState.values ? finalForm.getIn(formState.values, name) : undefined;
+      if (valueToSet !== undefined && currentValue === undefined) {
         form.change(name, valueToSet);
       }
     }
