{
  "name": "ilmomasiina",
  "version": "3.0.0-alpha.1",
  "private": true,
  "bugs": {
    "url": "https://github.com/Fyysikkokilta/ilmomasiina/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fyysikkokilta/ilmomasiina"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "clean": "pnpm run -r clean",
    "build": "pnpm run -r --workspace-concurrency=1 build",
    "start": "pnpm run -r --parallel start",
    "start:backend": "pnpm run --filter ilmomasiina-backend start",
    "start:frontend": "pnpm run --filter ilmomasiina-frontend start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && pnpm run format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm run -r --workspace-concurrency=1 typecheck",
    "test": "pnpm run -r test",
    "test:backend": "pnpm run --filter ilmomasiina-backend test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.18.0"
}
